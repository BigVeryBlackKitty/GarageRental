{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build wxWidgets",
      "type": "shell",
      "command": "g++",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "`wx-config --cxxflags --libs`"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [ "$gcc" ],
      "options": {
        "cwd": "${fileDirname}"
      }
    }
  ]
}